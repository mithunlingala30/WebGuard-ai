# ---------------------------------------------------------------------------
# WebGuard AI configuration.  Copy this file to ".env" (setup_windows.bat does
# it for you) and edit the values.  Lines starting with # are comments.
# ---------------------------------------------------------------------------

# Secret key for sessions. Leave empty to auto-generate one into instance/secret_key
WEBGUARD_SECRET_KEY=

# Network binding for the web application
WEBGUARD_HOST=127.0.0.1
WEBGUARD_PORT=5000
WEBGUARD_DEBUG=false

# Idle session timeout in minutes (session expires after this much inactivity)
WEBGUARD_SESSION_TIMEOUT_MINUTES=30

# Set to true only when serving over HTTPS (marks the session cookie "Secure")
WEBGUARD_SESSION_COOKIE_SECURE=false

# --- Scanner safety ---------------------------------------------------------
# Comma separated list of targets the administrator has authorised for testing.
#   example.com            -> example.com and its sub-domains (approved ports only)
#   localhost:3000         -> exactly this host and port (used for lab targets)
# WebGuard AI refuses to scan anything that is not on this list.
# Defaults (used when this variable is not set): local lab ports for OWASP Juice
# Shop (3000), WebGoat (8080), the bundled test site (8000) and two public sites
# that their owners publish specifically for scanner testing.
# WEBGUARD_ALLOWED_TARGETS=localhost:3000,127.0.0.1:3000,localhost:8080,127.0.0.1:8080,localhost:8000,127.0.0.1:8000,testphp.vulnweb.com,demo.testfire.net

# Lab mode lets loopback / private-network targets be scanned, but ONLY when the
# host is also listed above. Needed for Juice Shop / WebGoat on your own PC.
# Turn it OFF if WebGuard AI is ever deployed on a shared server.
WEBGUARD_LAB_MODE=true

# Ports that may be scanned (comma separated)
# WEBGUARD_APPROVED_PORTS=80,443,3000,5000,8000,8080,8081,8443,8888,9000

# --- Optional: OWASP ZAP integration (used by the "full" scan profile) -------
# Start ZAP (daemon mode) first, e.g.:  zap.bat -daemon -port 8090 -config api.key=changeme
WEBGUARD_ZAP_ENABLED=false
WEBGUARD_ZAP_API_URL=http://127.0.0.1:8090
WEBGUARD_ZAP_API_KEY=changeme
WEBGUARD_ZAP_MAX_SECONDS=600
